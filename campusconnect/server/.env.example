# ---- Server ----
PORT=5050
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (MySQL / MariaDB) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campusconnect_db

# ---- Authentication ----
JWT_SECRET=campus_connect_unilus_secret_key_2026
JWT_EXPIRES_IN=7d

# ---- Student verification ----
# Accounts registered with one of these e-mail domains are verified
# automatically; all others are queued for administrator approval.
AUTO_VERIFY_DOMAINS=unilus.ac.zm,student.unilus.ac.zm
REQUIRE_VERIFIED_TO_POST=true

# ---- Listing expiry / auto-archive ----
LISTING_TTL_DAYS=60
MAINTENANCE_INTERVAL_MINUTES=30

# ---- E-mail notifications (optional) ----
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Campus Connect <no-reply@campusconnect.local>
